#!/bin/bash

set -euxo pipefail

REGION="${aws_region}"
ACCOUNT_ID="${account_id}"
IMAGE="${ecr_repository_url}:${image_tag}"
SECRET_ID="${secret_name}"
LOG_GROUP="${log_group}"

# ---------------------------------------------------------
# INSTALL DOCKER
# ---------------------------------------------------------

dnf update -y
dnf install -y docker

systemctl enable docker
systemctl start docker


# ---------------------------------------------------------
# LOGIN TO ECR
# ---------------------------------------------------------

aws ecr get-login-password \
  --region "$REGION" \
  | docker login \
      --username AWS \
      --password-stdin \
      "$ACCOUNT_ID.dkr.ecr.$REGION.amazonaws.com"


# ---------------------------------------------------------
# PULL STAYOPS
# ---------------------------------------------------------

docker pull "$IMAGE"


# ---------------------------------------------------------
# RETRIEVE OPENAI SECRET
# ---------------------------------------------------------

OPENAI_API_KEY=$(aws secretsmanager get-secret-value \
  --secret-id "$SECRET_ID" \
  --region "$REGION" \
  --query SecretString \
  --output text)


# ---------------------------------------------------------
# PERSIST SQLITE OUTSIDE THE CONTAINER
# ---------------------------------------------------------

mkdir -p /opt/stayops/database

if [ ! -f /opt/stayops/database/stayops.db ]; then

  docker rm -f stayops-seed || true

  docker create \
    --name stayops-seed \
    "$IMAGE"

  docker cp \
    stayops-seed:/app/backend/database/stayops.db \
    /opt/stayops/database/stayops.db

  docker rm stayops-seed

fi


# ---------------------------------------------------------
# RUN STAYOPS
# ---------------------------------------------------------

docker rm -f stayops-backend || true

docker run -d \
  --name stayops-backend \
  --restart unless-stopped \
  -p 8000:8000 \
  -e OPENAI_API_KEY="$OPENAI_API_KEY" \
  -v /opt/stayops/database/stayops.db:/app/backend/database/stayops.db \
  --log-driver=awslogs \
  --log-opt awslogs-region="$REGION" \
  --log-opt awslogs-group="$LOG_GROUP" \
  --log-opt awslogs-stream="stayops-backend" \
  "$IMAGE"